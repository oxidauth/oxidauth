# General
ENVIRONMENT=local
RUST_LOG=INFO
# empty = host-native platform (compose omits platform:); pin e.g. linux/amd64 only if you must match deploy arch
DOCKER_PLATFORM=
RUST_DEV_IMAGE_VERSION="v1.98.0"

# Database (host-side tooling reaches postgres through the aka tcp route —
# VIRTUAL_HOST postgres.oxidauth.localhost published on VIRTUAL_PORT 5432)
POSTGRES_HOST=postgres.oxidauth.localhost
POSTGRES_PORT=5432
POSTGRES_USER=oxidauth
POSTGRES_PASSWORD=oxidauth
POSTGRES_DATABASE=oxidauth
DATABASE_URL=postgres://oxidauth:oxidauth@postgres.oxidauth.localhost:5432/oxidauth
READ_DATABASE_URL=postgres://oxidauth:oxidauth@postgres.oxidauth.localhost:5432/oxidauth
MIGRATIONS_ENABLED=true

# Oxidauth
OXIDAUTH_USERNAME_PASSWORD_PEPPER=pepper

# Deterministic bootstrap (optional): pin the seeded authority client_key (UUID) and
# admin password; leave unset and bootstrap generates random values at first boot
# OXIDAUTH_DEFAULT_CLIENT_KEY=
# OXIDAUTH_DEFAULT_ADMIN_PASSWORD=

# Console build config (optional): override the api url the console is built
# against (default: http://api.oxidauth.localhost)
# OXIDAUTH_WEB_API_URL=
